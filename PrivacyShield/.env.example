# PrivacyShield - Environment Configuration
# Problem Statement: PS-02 DPDP-Ready Privacy Gateway for Enterprise LLMs

# Groq Cloud Configuration
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Supabase Configuration
# Get your credentials at: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
ENABLE_LEAKAGE_STRICT_ABORT=true
